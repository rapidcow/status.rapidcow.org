#!/usr/bin/env perl
#
# Usage: scripts/update-needs
#
# Run this after adding (or removing) an entry under feed/.  It
# brings everything that lists the entries up to date:
#
#   - the NEED headers of feed.html, feed.xml and index.html
#     (one per feed/YEAR/DATE.dat)
#   - Makefile.in: the rule making feed/YEAR/DATE.html
#   - MANIFEST: the goal NEEDs feed/YEAR/DATE.html
#
# The last two are kept between BEGIN/END marker comments.  Run
# `siteconf -g' afterwards if you want a new Makefile.
#
use v5.14;
use strict;
use warnings;

use Cwd qw( abs_path );
use File::Basename qw( dirname );

chdir dirname(abs_path($0)) . '/..' or die "chdir: $!\n";

my @dat = sort {
	# by date, which is the file name
	(my $x = $a) =~ s{.*/}{};
	(my $y = $b) =~ s{.*/}{};
	$x cmp $y
} glob 'feed/[0-9][0-9][0-9][0-9]/*.dat';
my @html = map { s/[.]dat\z/.html/r } @dat;

sub slurp {
	my $file = shift;
	open my $fh, '<:encoding(UTF-8)', $file or die "open <$file: $!\n";
	local $/;
	my $text = <$fh>;
	close $fh;
	$text;
}

sub update {
	my ($file, $text) = @_;
	return if slurp($file) eq $text;
	open my $fh, '>:encoding(UTF-8)', $file or die "open >$file: $!\n";
	print $fh $text;
	close $fh or die "close $file: $!\n";
	say STDERR "Updating $file";
}

# The NEEDs sit right after the HAVE in the header; whatever
# NEEDs on .dat files were there are replaced.
for my $file (qw( feed.html feed.xml index.html )) {
	my $text = slurp($file);
	$text =~ s/^ # NEED: \S+[.]dat\n//mg;
	$text =~ s/^( # HAVE: .*\n)/$1 # NEED: $_\n/m
		or die "$file: no HAVE header\n"
		for reverse @dat;
	update($file, $text);
}

# Replace what is between the markers (and nothing else).
sub block {
	my ($file, @lines) = @_;
	my $lines = join '', @lines;
	my $text = slurp($file);
	my $begin = "# BEGIN feed entries (scripts/update-needs)\n";
	my $end = "# END feed entries\n";
	$text =~ s/^\Q$begin\E.*?^\Q$end\E/$begin$lines$end/ms
		or die "$file: missing BEGIN/END feed entries markers\n";
	update($file, $text);
}

# Targets are named from ${b}; the source is the .dat beside it
# (the suffix transformation, .dat to .html).  The recipe is
# Makefile.in's own, right after the END marker.
@html or die "no entries under feed/\n";
block('Makefile.in',
	(map { "$_ \\\n" } @html),
	": \${a}/\${\@:R}.dat entry.html\n");
block('MANIFEST', map { "\tNEED $_\n" } @html);
