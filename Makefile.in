index.html feed.html feed.xml:
	cd -- ${A} && ./optenv ${B} ${^X} mkpub.pl ${a}/${.TARGET} > ${B}/${b}/${.TARGET}

robots.txt:
	cd -- ${A} && cp ${a}/${.TARGET} ${B}/${b}/${.TARGET}

# Each year has an index, feed/YEAR/index.html (a source of its own,
